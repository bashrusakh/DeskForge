# offline-kit/versions.env — единая точка пинов для суверенной сборки.
# The 1.4.8 values were historically extracted from the upstream tag and its
# then-referenced build metadata (including the historical flutter-build.yml).
# That workflow is absent from the current fork; active workflow truth is in the
# configured RustDesk fork's rustqs/bridge files.
# Меняешь версию клиента — обновляй ВСЕ пины ниже под соответствующий тег.

# --- Источник клиента (параметризуемо для downstream-форкеров, PLAN.md §7) ---
# По умолчанию указывает на upstream; для своего форка замени на github.com/ВЫ/rustdesk
RUSTDESK_REPO="https://github.com/rustdesk/rustdesk.git"
RUSTDESK_REF="1.4.8"
RUSTDESK_COMMIT="3c574a41821170f89f38141a493e127145dbf82d"
HBB_COMMON_REPO="https://github.com/rustdesk/hbb_common.git"

# --- Тулчейн (L3) ---
RUST_VERSION="1.75.0"
LLVM_VERSION="15.0.6"
FLUTTER_VERSION="3.24.5"
FLUTTER_RUST_BRIDGE_VERSION="1.80"
NDK_VERSION="r28c"
CARGO_NDK_VERSION="3.1.2"

# --- Flutter кастомный engine (release-asset, не git) ---
FLUTTER_ENGINE_WIN_URL="https://github.com/rustdesk/engine/releases/download/main/windows-x64-release.zip"

# --- Flutter SDK архивы ---
FLUTTER_SDK_WIN_URL="https://storage.googleapis.com/flutter_infra_release/releases/stable/windows/flutter_windows_3.24.5-stable.zip"
FLUTTER_SDK_LINUX_URL="https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.24.5-stable.tar.xz"

# --- vcpkg (L3) ---
VCPKG_REPO="https://github.com/microsoft/vcpkg.git"
VCPKG_BASELINE="120deac3062162151622ca4860575a33844ba10b"
VCPKG_TRIPLET="x64-windows-static"
# Полный список зависимостей берётся из rustdesk/vcpkg.json (overlay-ports res/vcpkg).
# Для Windows-сборки фактически нужны (с host=true/false вариантами):
#   aom libjpeg-turbo opus libvpx libyuv mfx-dispatch ffmpeg
# ВНИМАНИЕ: ffmpeg с фичами amf/nvcodec/qsv (hwcodec) — тяжёлый, собирается
# только на Windows-хосте с MSVC. Binary cache заполняется на этапе win-build (PLAN.md §8.3).

# --- Сторонние артефакты Windows-сборки (release-assets + один репо) ---
# RustDeskTempTopMostWindow: the active frozen RustDesk workflow is the local
# evidence at artifacts/rustdesk-src/.github/workflows/
# third-party-RustDeskTempTopMostWindow.yml; its checkout pin is
# ecd8d6a139eee76845ea66423fb739af450fda90.
# verify.sh compares this value with that workflow and with the local bundle.
TOPMOST_REPO="https://github.com/rustdesk-org/RustDeskTempTopMostWindow.git"
TOPMOST_COMMIT="ecd8d6a139eee76845ea66423fb739af450fda90"
# usbmmidd_v2: виртуальный дисплей-драйвер (release-asset)
USBMMIDD_URL="https://github.com/rustdesk-org/rdev/releases/download/usbmmidd_v2/usbmmidd_v2.zip"
# Принтер-драйверы (release-assets hbb_common)
PRINTER_DRIVER_URL="https://github.com/rustdesk/hbb_common/releases/download/driver/rustdesk_printer_driver_v4-1.4.zip"
PRINTER_ADAPTER_URL="https://github.com/rustdesk/hbb_common/releases/download/driver/printer_driver_adapter.zip"
PRINTER_SUMS_URL="https://github.com/rustdesk/hbb_common/releases/download/driver/sha256sums"

# --- Куда складывать артефакты ---
ARTIFACTS_DIR="artifacts"

# --- Ожидаемые SHA-256 локальных файлов (не URL-доказательство) ---
# Пустое значение запрещает freeze без явного --allow-tofu и всегда
# делает offline-kit --verify неуспешным до ручного подтверждения.
RUSTDESK_BUNDLE_SHA256="eec4cd6587489864c0dc8eab4b8ed983521099faafce8dcdc77170c59798390d"
VENDOR_TARBALL_SHA256="bec49649ff3c0a49fc4cf2f5ff2aff3a459f2f6fb45039cbe8b89a9995d8a4b6"
FLUTTER_ENGINE_WIN_SHA256="ec8cabf36ee4ff24c8d98de25b00e70781eb03876265aee84d0fe554a110036e"
FLUTTER_SDK_WIN_SHA256="b8a7485acd3c6fb23a76b7ac09f89e8d93d62fbff7147c6f5f8c5686d949eeac"
FLUTTER_SDK_LINUX_SHA256="a7c82f551a9eae018e078f6bb186171e5a77920d35a3d75a61d9a593d0a9e4ae"
RUST_WIN_MSI_SHA256="c090304864698576114cda578d43da2c81abaf9263efddf1bfc9ea5900cda07f"
TOPMOST_BUNDLE_SHA256="7752c8c2be7a7e7c7affd0f7c67ec5755e797b13d8e5706726c0140c8ad572ea"
USBMMIDD_SHA256="629b51e9944762bae73948171c65d09a79595cf4c771a82ebc003fbba5b24f51"
PRINTER_DRIVER_SHA256="c4cf4d3b48c4d9079b243edc43bb1db03b076282bc259c9f49883e9db20fa8b5"
PRINTER_ADAPTER_SHA256="e90e5d52c8807b4c6293c78a52479338715e0bf396b1b34802777b8c452e6781"
# The sidecar checksum file is provider-supplied and needs a manually checked
# digest before it can be accepted by the fail-closed path.
PRINTER_SUMS_SHA256=""
